# Multi-stage build for testing linsec-audit in an intentionally vulnerable Linux container
FROM golang:bookworm AS builder

ENV GOTOOLCHAIN=auto
WORKDIR /src

COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/linsec-audit ./cmd/linsec-audit

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      openssh-server \
      sudo \
      ufw \
      passwd \
      procps && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/linsec-audit /usr/local/bin/linsec-audit
RUN chmod 0755 /usr/local/bin/linsec-audit

# Deliberate misconfigurations for container integration test

# 1. Weak SSH daemon configuration (SSH-001..SSH-005 + FIL-004)
RUN mkdir -p /etc/ssh/sshd_config.d /run/sshd && \
    printf '%s\n' \
      'Port 22' \
      'PermitRootLogin yes' \
      'PasswordAuthentication yes' \
      'MaxAuthTries 10' \
      'X11Forwarding yes' \
      'PermitEmptyPasswords yes' \
      > /etc/ssh/sshd_config && \
    chmod 0644 /etc/ssh/sshd_config

# 2. Rogue UID 0 account, empty-password user, NOPASSWD sudoers, weak login.defs
RUN useradd -m -s /bin/bash guest && \
    sed -i 's/^guest:[^:]*:/guest::/' /etc/shadow && \
    echo 'toor:x:0:0:root:/root:/bin/bash' >> /etc/passwd && \
    echo 'toor:!:19000:0:99999:7:::' >> /etc/shadow && \
    printf 'guest ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/90-vuln-nopasswd && \
    chmod 0440 /etc/sudoers.d/90-vuln-nopasswd && \
    sed -i 's/^[#[:space:]]*PASS_MAX_DAYS.*/PASS_MAX_DAYS\t99999/' /etc/login.defs && \
    sed -i 's/^[#[:space:]]*PASS_MIN_DAYS.*/PASS_MIN_DAYS\t0/' /etc/login.defs

# 3. Dangerous SUID GTFOBins copy + insecure permissions on critical auth files
RUN cp /usr/bin/find /usr/local/bin/find && \
    chmod 4755 /usr/local/bin/find && \
    chmod 0644 /etc/shadow && \
    chmod 0666 /etc/passwd && \
    chmod 0644 /etc/sudoers

# 4. Disabled host firewall (NET-003)
RUN mkdir -p /etc/ufw && \
    printf '[ufw]\nENABLED=no\nLOGLEVEL=low\n' > /etc/ufw/ufw.conf

WORKDIR /root

CMD ["/bin/bash", "-c", "echo '=== [1/3] INITIAL VULNERABLE SCAN ===' && linsec-audit scan --gen-fix && echo '' && echo '=== [2/3] APPLYING REMEDIATION ===' && bash ./remediate.sh && echo '' && echo '=== [3/3] POST-REMEDIATION SCAN ===' && linsec-audit scan"]
